# Skopiuj do server/.env i uzupełnij. Pliku .env nie ma w repozytorium.

# Adres, pod którym działa serwer (bez końcowego ukośnika). Musi zgadzać się z aplikacją OAuth w GitHubie.
BASE_URL=http://localhost:8787
PORT=8787

# Losowy sekret do podpisywania sesji, min. 32 znaki:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Aplikacja OAuth: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:8787
#   Authorization callback URL: http://localhost:8787/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Loginy GitHub z dostępem do panelu, po przecinku
ADMIN_GITHUB_LOGINS=
